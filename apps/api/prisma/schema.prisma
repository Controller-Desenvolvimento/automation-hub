generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum ExecutionStatus {
  queued
  running
  success
  error
  canceled
}

enum ScheduleFrequency {
  once
  daily
  weekly
  monthly
}

enum RecipientScope {
  all
  departments
  specific
}

enum UserRole {
  admin
  manager
  employee
}

enum SiteStatus {
  online
  maintenance
  down
}

enum SiteCategory {
  sistema
  bi
}

enum AutomationRequestStatus {
  pending
  review
  approved
  in_progress
  done
  rejected
}

enum AutomationRequestUrgency {
  low
  normal
  high
  urgent
}

enum AutomationRequestCadence {
  once
  daily
  weekly
  monthly
}

model SharedCredential {
  id                 String   @id @default(cuid())
  name               String
  url                String?
  login              String
  password           String
  notes              String?
  allowedDepartments String[] @default([])
  minRole            UserRole @default(employee)
  order              Int      @default(0)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
}

model AutomationRequest {
  id                String                    @id @default(cuid())
  requesterUserId   String
  requesterUser     User                      @relation(fields: [requesterUserId], references: [id], onDelete: Cascade)
  requesterName     String
  requesterEmail    String
  title             String
  systemName        String?
  portalUrl         String?
  description       String
  urgency           AutomationRequestUrgency  @default(normal)
  cadence           AutomationRequestCadence  @default(once)
  requiresLogin     Boolean                   @default(false)
  requiresCertificate Boolean                 @default(false)
  requiresCaptcha   Boolean                   @default(false)
  status            AutomationRequestStatus   @default(pending)
  adminNotes        String?
  createdAt         DateTime                  @default(now())
  updatedAt         DateTime                  @updatedAt

  @@index([status, createdAt])
  @@index([requesterUserId, createdAt])
}

model DepartmentConfig {
  id        String   @id @default(cuid())
  slug      String   @unique
  name      String
  isActive  Boolean  @default(true)
  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Site {
  id                  String       @id @default(cuid())
  slug                String       @unique
  name                String
  url                 String
  description         String?
  category            SiteCategory @default(sistema)
  status              SiteStatus   @default(online)
  maintenanceOverride Boolean      @default(false)
  order               Int          @default(0)
  lastCheckedAt       DateTime?
  faviconStoragePath  String?
  faviconMimeType     String?
  allowedDepartments  String[]     @default([])
  allowedUserIds      String[]     @default([])
  minRole             UserRole     @default(employee)
  powerbiGroupId          String?
  powerbiDatasetId        String?
  powerbiRefreshStatus    String?
  powerbiRefreshRequestId String?
  powerbiLastRefreshAt    DateTime?
  powerbiScheduledTimes   String[]     @default([])
  powerbiShowRefresh      Boolean      @default(true)
  ssoEnabled              Boolean      @default(false)
  // Painel (Dashboard) cujo chat de IA responde as perguntas feitas no chat do
  // hub enquanto este BI está aberto em "Ver". Vazio = chat normal do hub.
  linkedDashboardId       String?
  createdAt              DateTime     @default(now())
  updatedAt           DateTime     @updatedAt

  refreshLogs     PowerBIRefreshLog[]
  linkedDashboard Dashboard?          @relation(fields: [linkedDashboardId], references: [id], onDelete: SetNull)

  @@index([linkedDashboardId])
}

model PowerBIRefreshLog {
  id               String    @id @default(cuid())
  siteId           String
  site             Site      @relation(fields: [siteId], references: [id], onDelete: Cascade)
  requestedByName  String?
  requestedByEmail String?
  status           String    @default("Unknown")
  requestedAt      DateTime  @default(now())
  completedAt      DateTime?

  @@index([siteId, requestedAt])
  @@index([requestedAt])
}

model Robot {
  id                   String       @id @default(cuid())
  slug                 String       @unique
  name                 String
  summary              String?
  description          String?
  category             String?
  icon                 String?      @default("bot")
  isActive             Boolean      @default(true)
  version              String       @default("1.0.0")
  estimatedMinutes     Int?
  maxConcurrency       Int          @default(1)
  conflictKeys         String?
  manualSecondsPerUnit Int          @default(0)
  unitLabel            String?      @default("item")
  unitMetricKey        String?      @default("itens_processados")
  zipOutput            Boolean      @default(false)
  command              String?
  workingDirectory     String?
  scriptFileName       String?
  isExternal           Boolean      @default(false)
  apiKeyHash           String?      @unique
  allowedDepartments   String[]     @default([])
  allowedUserIds       String[]     @default([])
  schema               Json?
  documentationUrl     String?
  documentationLabel   String?
  supportLabel         String?
  supportValue         String?
  dataPolicy           String?
  createdAt            DateTime     @default(now())
  updatedAt            DateTime     @updatedAt

  executions     Execution[]
  scheduledTasks ScheduledTask[]
  inputExamples  RobotInputExample[]
  favorites      RobotFavorite[]
}

model User {
  id           String       @id @default(cuid())
  name         String
  email        String       @unique
  athenasLogin String?      @unique
  passwordHash String
  role         UserRole     @default(employee)
  departments  String[]     @default([])
  isActive     Boolean      @default(true)
  mascotSkin   String       @default("midas")
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  sessions       Session[]
  executions     Execution[]
  scheduledTasks ScheduledTask[]
  automationRequests AutomationRequest[]
  notifications  Notification[]
  robotFavorites RobotFavorite[]
  siteChatMessages SiteChatMessage[]
}

model SiteChatMessage {
  id               String   @id @default(cuid())
  userId           String
  role             String
  content          String
  promptTokens     Int?
  completionTokens Int?
  attachmentPath   String?
  attachmentName   String?
  // Conversa a que a mensagem pertence: "hub" (chat do hub) ou "dash:<id do
  // painel>" (conversa com o chat de IA de um painel/BI) — cada uma tem o seu histórico.
  scope            String   @default("hub")
  createdAt        DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([userId, scope, createdAt])
}

model RobotFavorite {
  userId    String
  robotId   String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  robot     Robot    @relation(fields: [robotId], references: [id], onDelete: Cascade)

  @@id([userId, robotId])
  @@index([robotId])
}

model ExternalIdentity {
  login      String   @id
  name       String
  department String?
  ignored    Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([department])
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId, expiresAt])
}

model Execution {
  id                     String          @id @default(cuid())
  robotId                String
  robot                  Robot           @relation(fields: [robotId], references: [id])
  userId                 String?
  user                   User?           @relation(fields: [userId], references: [id])
  requestedByName        String?
  requestedByEmail       String?
  notes                  String?
  status                 ExecutionStatus @default(queued)
  priority               Int             @default(0)
  progress               Int             @default(0)
  currentStep            String?
  inputJson              Json?
  unitsProcessed         Int?
  manualEstimatedSeconds Int?
  errorMessage           String?
  outputZipPath          String?
  createdAt              DateTime        @default(now())
  startedAt              DateTime?
  finishedAt             DateTime?
  canceledAt             DateTime?
  cleanedAt              DateTime?
  externalId             String?

  scheduledTaskId String?
  // 1 = execução agendada original; 2 = reinício automático da verificação por tempo (só acontece uma vez).
  attempt         Int            @default(1)
  // Execução (tentativa 1) que esta (tentativa 2) está refazendo.
  restartOfId     String?
  // Qual aviso por tempo já foi enviado: 0 = nenhum, 1 = T0, 2 = T1 (evita e-mail repetido).
  checkStage      Int            @default(0)
  // Execução retida por dependência: id da 1ª execução do ciclo do agendamento de que depende. Enquanto preenchido, a
  // fila não a inicia; é limpo quando esse ciclo termina com sucesso (ou a execução é cancelada se ele falhar).
  waitingOnExecutionId String?
  // O e-mail do agendamento do qual dependia já informou que esta execução não rodou (evita avisar duas vezes).
  dependencyNotified   Boolean       @default(false)
  logs            ExecutionLog[]
  files           ExecutionFile[]
  notifications   Notification[]

  @@unique([robotId, externalId])
  @@index([restartOfId])
  @@index([robotId])
  @@index([userId, createdAt])
  @@index([status, createdAt])
  @@index([scheduledTaskId])
  @@index([createdAt])
  @@index([cleanedAt, finishedAt])
}

model ExecutionLog {
  id          String    @id @default(cuid())
  executionId String
  execution   Execution @relation(fields: [executionId], references: [id])
  level       String    @default("info")
  message     String
  timestamp   DateTime  @default(now())

  @@index([executionId, timestamp])
}

model ExecutionFile {
  id           String    @id @default(cuid())
  executionId  String
  execution    Execution @relation(fields: [executionId], references: [id])
  kind         String    @default("output")
  filename     String
  originalName String?
  storagePath  String
  downloadName String?
  mimeType     String?
  size         Int?
  createdAt    DateTime  @default(now())

  @@index([executionId, createdAt])
}

model ScheduledTask {
  id                   String            @id @default(cuid())
  name                 String
  robotId              String
  robot                Robot             @relation(fields: [robotId], references: [id])
  userId               String
  user                 User              @relation(fields: [userId], references: [id])
  frequency            ScheduleFrequency
  timeOfDay            String
  timesOfDay           String[]          @default([])
  startDate            DateTime?
  dayOfWeek            Int?
  dayOfMonth           Int?
  timezone             String            @default("America/Sao_Paulo")
  notes                String?
  parameters           Json?
  recipientScope       RecipientScope    @default(specific)
  recipientDepartments String[]          @default([])
  recipientUserIds     String[]          @default([])
  creditMode           String            @default("creator")
  creditUserIds        String[]          @default([])
  creditDepartment     String?
  isActive             Boolean           @default(true)
  lastRunAt            DateTime?
  nextRunAt            DateTime
  lastError            String?
  lastExecutionId      String?
  // Verificação por tempo (todos null = "sem verificação"). Contada a partir do INÍCIO da execução:
  // T0 = verifyT0Minutes; T1 = T0 + verifyT1Minutes; T2 = T1 + verifyT2Minutes.
  // T0 e T1 avisam por e-mail que ainda está rodando; em T2 a execução é cancelada e reiniciada (1 vez).
  verifyT0Minutes      Int?
  verifyT1Minutes      Int?
  verifyT2Minutes      Int?
  // Teto de tempo para quem está "sem verificação": passou disso rodando, a execução é cancelada e avisa (sem reinício).
  // Fica null quando há T0/T1/T2 (o T2 já é o teto).
  maxRuntimeMinutes    Int?
  // Dependência: a execução agendada só começa depois que o ciclo do agendamento indicado terminar com sucesso
  // (ex.: Atualizar Planilhas depende de Gestta). Se esse agendamento for apagado, o campo é limpo.
  dependsOnTaskId      String?
  dependsOn            ScheduledTask?    @relation("TaskDependency", fields: [dependsOnTaskId], references: [id], onDelete: SetNull)
  dependents           ScheduledTask[]   @relation("TaskDependency")
  createdAt            DateTime          @default(now())
  updatedAt            DateTime          @updatedAt

  @@index([dependsOnTaskId])
  @@index([isActive, nextRunAt])
  @@index([userId, createdAt])
  @@index([robotId, createdAt])
}

model Notification {
  id          String     @id @default(cuid())
  userId      String
  user        User       @relation(fields: [userId], references: [id])
  executionId String?
  execution   Execution? @relation(fields: [executionId], references: [id])
  type        String     @default("execution_result")
  title       String
  body        String?
  isRead      Boolean    @default(false)
  createdAt   DateTime   @default(now())

  @@index([userId, isRead, createdAt])
  @@index([executionId])
}

model RobotInputExample {
  id            String   @id @default(cuid())
  robotId       String
  robot         Robot    @relation(fields: [robotId], references: [id], onDelete: Cascade)
  fileInputName String?
  title         String?
  description   String?
  filename      String
  storagePath   String
  downloadName  String?
  mimeType      String?
  size          Int?
  createdAt     DateTime @default(now())

  @@index([robotId, createdAt])
}

model ExternalMetric {
  id                     String   @id @default(cuid())
  createdAt              DateTime @default(now())

  // Identificação da fonte
  source                 String   // identificador de máquina, ex: "bi_dre_contabil"
  sourceName             String?  // nome de exibição, ex: "DRE Contábil"
  action                 String   // ex: "baixar_empresa"
  label                  String?  // descrição do registro, ex: "Empresa X"
  unitLabel              String   @default("empresa")

  // Atribuição de usuário
  userName               String?
  userEmail              String?
  department             String?

  // Métricas
  unitsProcessed         Int      @default(1)
  manualSecondsPerUnit   Int      @default(0)
  manualEstimatedSeconds Int      @default(0)

  @@index([createdAt])
  @@index([source, createdAt])
  @@index([userEmail, createdAt])
}

enum DashboardType {
  html
  streamlit
  server
}

model Dashboard {
  id                    String        @id @default(cuid())
  slug                  String        @unique
  name                  String
  description           String?
  type                  DashboardType @default(html)
  isActive              Boolean       @default(true)
  allowedDepartments    String[]      @default([])
  minRole               UserRole      @default(employee)
  allowedUserIds        String[]      @default([])
  mainFile              String        @default("index.html")
  streamlitPort         Int?
  streamlitStatus       String?
  serverCommand         String?
  serverWorkingDirectory String?
  updatePath            String?
  warmupPaths           String[]      @default([])
  warmupMode            String        @default("manual")
  updateFrequency       String?
  updateTimesOfDay      String[]      @default([])
  updateDayOfWeek       Int?
  updateDayOfMonth      Int?
  lastUpdateAt          DateTime?
  lastUpdateStatus      String?
  // Motivo da última falha de atualização (some quando uma atualização dá certo). Só admin vê.
  lastUpdateError       String?
  // Segunda tentativa agendada depois de uma falha da atualização programada (null = nada pendente).
  // Fica no banco para sobreviver a um reinício do Hub entre as duas tentativas.
  updateRetryAt         DateTime?
  // Envio do rastreamento ("traces") do SDK openai-agents à OpenAI. Desligado por padrão: o rastreamento leva as
  // perguntas e o que o assistente leu dos dados do painel. Vale a partir do próximo (re)início do painel.
  aiTracing             Boolean       @default(false)
  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt

  linkedSites Site[]

  @@index([slug])
}

model DevDoc {
  id          String   @id @default(cuid())
  title       String
  category    String
  summary     String   @db.Text
  howToUse    String   @db.Text
  codeExample String?  @db.Text
  language    String?
  endpoint    String?
  tags        String[]
  order       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}
