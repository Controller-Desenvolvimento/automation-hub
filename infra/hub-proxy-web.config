<?xml version="1.0" encoding="UTF-8"?>
<configuration>
  <system.webServer>
    <security>
      <requestFiltering>
        <!-- 2 GB em bytes -->
        <requestLimits maxAllowedContentLength="2147483648" />
      </requestFiltering>
    </security>
    <!-- ARR proxy timeout: 20 minutos para downloads longos via dashboards -->
    <proxy enabled="true" timeout="00:20:00" />
    <rewrite>
      <rules>
        <rule name="ReverseProxyToHub" stopProcessing="true">
          <match url="(.*)" />
          <action type="Rewrite" url="http://localhost:3000/{R:1}" />
        </rule>
      </rules>
    </rewrite>
  </system.webServer>
</configuration>
